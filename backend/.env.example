PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todo_app?schema=public"

# Secret used to sign and verify authentication JWTs.
# Use a long, random string and keep it private in production.
JWT_SECRET="replace-with-a-long-random-secret"

# How long issued JWTs remain valid (optional, defaults to 7d)
JWT_EXPIRES_IN=7d

# Secret used to sign and verify authentication JWTs. Use a long, random value in production.
JWT_SECRET="replace-with-a-long-random-secret"
